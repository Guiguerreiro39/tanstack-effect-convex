{
  "name": "tanstack-effect-convex",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "oxlint && oxfmt --write",
    "prepare": "husky",
    "ruler:apply": "pnpm dlx @intellectronica/ruler@latest apply --local-only",
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @tanstack-effect-convex/backend dev",
    "dev:setup": "turbo -F @tanstack-effect-convex/backend dev:setup"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:",
    "@tanstack-effect-convex/env": "workspace:*"
  },
  "devDependencies": {
    "turbo": "^2.6.3",
    "@biomejs/biome": "2.3.10",
    "ultracite": "6.5.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "oxlint": "^1.34.0",
    "oxfmt": "^0.19.0",
    "typescript": "catalog:",
    "@tanstack-effect-convex/config": "workspace:*"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "pnpm dlx ultracite fix"
    ]
  },
  "packageManager": "pnpm@10.19.0"
}
